DB_HOST=localhost
DB_USER=order_service_user
DB_PASSWORD=password
DB_NAME=order_service
DB_PORT=5433
DB_SSLMODE=disable
DB_TIMEZONE=UTC

PUBLIC_KEY_PATH=./keys/public.pem

# car-service's host-exposed port for local (non-Docker) development.
# Use http://car-service:8080 instead once order-service itself runs in
# the Compose network.
CAR_SERVICE_URL=http://localhost:8080

# order-service gets its service tokens from user-service (OAuth2 client
# credentials) and presents them to car-service when it reserves a car.
# Use http://user-service:8082 once order-service itself runs in the Compose network.
USER_SERVICE_URL=http://localhost:8082
OAUTH_CLIENT_ID=order-service
# Must equal ORDER_SERVICE_CLIENT_SECRET in user-service/.env. Empty on purpose:
# the service refuses to start without it. Generate one with: openssl rand -hex 32
OAUTH_CLIENT_SECRET=
