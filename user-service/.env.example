DB_HOST=localhost
DB_USER=user_service_user
DB_PASSWORD=password
DB_NAME=user_service
DB_PORT=5434
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# Path to the RSA private key user-service uses to sign JWTs. Generate it
# with openssl (see README) - never commit the actual key file.
PRIVATE_KEY_PATH=./keys/private.pem

# Seeds the first admin account at startup (see repository.EnsureAdminExists).
# Change the password before running against anything but your own machine.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Secret that order-service uses to ask for a service token (OAuth2 client
# credentials, POST /oauth/token). At least 32 characters; generate one with:
#   openssl rand -hex 32
# order-service needs the same value as its client secret.
# Left empty on purpose: user-service refuses to start until you set it.
ORDER_SERVICE_CLIENT_SECRET=
